# Copy this file to `.env` and fill in your key to enable the real LLM for
# natural-language querying (NL->SQL). Without a key the app uses the offline
# rule-based stub. `.env` is gitignored — never commit your real key.

OPENAI_API_KEY=sk-your-key-here

# Optional: which OpenAI chat model to use (default: gpt-4o-mini).
SSA_LLM_MODEL=gpt-4o-mini
