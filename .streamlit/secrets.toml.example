# Settings for a deployed instance.
#
# Do NOT commit a real secrets.toml — paste these values into the hosting
# provider's secrets box instead (on Streamlit Community Cloud:
# Manage app -> Settings -> Secrets). Locally, a .env file is used instead.

# Optional. Without a key the app falls back to the offline rule-based
# NL->SQL stub, which needs no network and costs nothing.
OPENAI_API_KEY = "sk-your-key-here"

# Optional. Which chat model to use (default: gpt-4o-mini).
SSA_LLM_MODEL = "gpt-4o-mini"

# Optional. Cap on language-model calls per day across the whole instance,
# so a public link cannot run up the bill (default: 100).
SSA_DAILY_LLM_LIMIT = "100"
